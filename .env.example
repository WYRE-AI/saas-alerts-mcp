# Single-tenant credential (stdio, and HTTP only when AUTH_MODE=env).
# The gateway compose service does not load this. Do not add it to that
# service's environment or via env_file.
SAAS_ALERTS_API_KEY=

# stdio (default) or http
# MCP_TRANSPORT=stdio

# Required to start the HTTP transport. Leave this empty.
# Generate a value with: openssl rand -hex 32
# The process exits if this is empty or a known placeholder (so a copied
# example cannot forge X-Gateway-S2S). docker compose will not start if it
# is unset or empty. Never commit a real secret. The value is never logged.
# Local development only: MCP_ALLOW_INSECURE_DEV=1 starts HTTP without this
# secret, logs a warning, skips X-Gateway-S2S, and binds 127.0.0.1 only.
# A non-loopback MCP_HTTP_HOST is overridden in that mode. A placeholder
# secret is still rejected.
CONDUIT_S2S_SECRET=
# MCP_ALLOW_INSECURE_DEV=1

# Bind address when a real CONDUIT_S2S_SECRET is set. Defaults to 127.0.0.1.
# The container image sets 0.0.0.0. Without a real secret the listener is
# forced to 127.0.0.1.
# MCP_HTTP_HOST=127.0.0.1
# MCP_HTTP_PORT=8080

# gateway (Docker image and Compose default) or env.
# Gateway mode requires X-SaaS-Alerts-API-Key on each /mcp request and never
# falls back to SAAS_ALERTS_API_KEY.
# AUTH_MODE=gateway

# LOG_LEVEL=info
